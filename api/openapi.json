{
  "openapi": "3.1.0",
  "info": {
    "title": "BaseLayer API",
    "version": "0.1.0",
    "description": "OpenAPI definition for the current Deno HTTP API implementation."
  },
  "servers": [
    {
      "url": "http://localhost:8000",
      "description": "Local development server"
    }
  ],
  "tags": [
    { "name": "Health" },
    { "name": "Auth" },
    { "name": "Projects" },
    { "name": "Project Progress" },
    { "name": "Groups" },
    { "name": "AI" }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["Health"],
        "summary": "Root service status",
        "operationId": "getRoot",
        "responses": {
          "200": {
            "description": "Service status.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/RootStatus" }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": ["Health"],
        "summary": "Health check",
        "operationId": "getHealth",
        "responses": {
          "200": {
            "description": "Health status and server timestamp.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/HealthStatus" }
              }
            }
          }
        }
      }
    },
    "/auth/register": {
      "post": {
        "tags": ["Auth"],
        "summary": "Register a user",
        "operationId": "registerUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthCredentials" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/AuthSuccess" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/auth/login": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log in a user",
        "operationId": "loginUser",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/AuthCredentials" }
            }
          }
        },
        "responses": {
          "200": { "$ref": "#/components/responses/AuthSuccess" },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/auth/refresh": {
      "post": {
        "tags": ["Auth"],
        "summary": "Refresh auth cookies",
        "operationId": "refreshAuth",
        "security": [{ "refreshCookie": [] }],
        "responses": {
          "200": { "$ref": "#/components/responses/AuthSuccess" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/auth/logout": {
      "post": {
        "tags": ["Auth"],
        "summary": "Log out and clear auth cookies",
        "operationId": "logoutUser",
        "responses": {
          "200": {
            "description": "Refresh token revoked when present and auth cookies cleared.",
            "headers": {
              "Set-Cookie": {
                "description": "Clears access_token and refresh_token cookies.",
                "schema": { "type": "string" }
              }
            },
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OkResponse" }
              }
            }
          },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/me": {
      "get": {
        "tags": ["Auth"],
        "summary": "Get the authenticated token user",
        "operationId": "getMe",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Authenticated token payload.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/MeResponse" }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/projects": {
      "get": {
        "tags": ["Projects"],
        "summary": "List projects",
        "operationId": "listProjects",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Project list.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["projects"],
                  "properties": {
                    "projects": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/Project" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/projects/create": {
      "post": {
        "tags": ["Projects"],
        "summary": "Create a project",
        "operationId": "createProject",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProjectInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "MongoDB insert result for the created project.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectInsertResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/projects/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdPathParam" }],
      "get": {
        "tags": ["Projects"],
        "summary": "Get a project",
        "operationId": "getProject",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Project found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["project"],
                  "properties": {
                    "project": { "$ref": "#/components/schemas/Project" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "patch": {
        "tags": ["Projects"],
        "summary": "Update a project",
        "operationId": "updateProject",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProjectUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated project.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["project"],
                  "properties": {
                    "project": { "$ref": "#/components/schemas/Project" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "delete": {
        "tags": ["Projects"],
        "summary": "Delete a project",
        "operationId": "deleteProject",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Project deleted.",
            "content": {
              "application/json": {
                "schema": { "$ref": "#/components/schemas/OkResponse" }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/projects/start": {
      "post": {
        "tags": ["Project Progress"],
        "summary": "Start project progress",
        "description": "The current Deno route returns HTTP 200 with a JSON status field set to 201.",
        "operationId": "startProject",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProjectProgressInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "MongoDB insert result for the project progress document.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProjectProgressStartResponse"
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/projects/progress": {
      "get": {
        "tags": ["Project Progress"],
        "summary": "List project progress documents",
        "operationId": "listProjectProgresses",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Project progress list for the authenticated user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["projectProgresses"],
                  "properties": {
                    "projectProgresses": {
                      "type": "array",
                      "items": {
                        "$ref": "#/components/schemas/ProjectProgress"
                      }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/projects/progress/{id}": {
      "parameters": [{ "$ref": "#/components/parameters/IdPathParam" }],
      "get": {
        "tags": ["Project Progress"],
        "summary": "Get project progress with project",
        "operationId": "getProjectProgress",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Project progress document populated with its project.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["projectProgress"],
                  "properties": {
                    "projectProgress": {
                      "$ref": "#/components/schemas/ProjectProgressWithProject"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "patch": {
        "tags": ["Project Progress"],
        "summary": "Update project progress",
        "operationId": "updateProjectProgress",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ProjectProgressInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated project progress document.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["projectProgress"],
                  "properties": {
                    "projectProgress": {
                      "$ref": "#/components/schemas/ProjectProgress"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/projects/progress/{id}/completed-items": {
      "parameters": [{ "$ref": "#/components/parameters/IdPathParam" }],
      "patch": {
        "tags": ["Project Progress"],
        "summary": "Merge completed item states",
        "operationId": "updateCompletedItems",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/CompletedItems" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated project progress document with recalculated progress.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["projectProgress"],
                  "properties": {
                    "projectProgress": {
                      "$ref": "#/components/schemas/ProjectProgress"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/groups": {
      "get": {
        "tags": ["Groups"],
        "summary": "Get authenticated user's group",
        "operationId": "getGroup",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Group found.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["group"],
                  "properties": {
                    "group": { "$ref": "#/components/schemas/Group" }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      },
      "patch": {
        "tags": ["Groups"],
        "summary": "Update authenticated user's group",
        "operationId": "updateGroup",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GroupUpdate" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Updated group.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["group"],
                  "properties": {
                    "group": { "$ref": "#/components/schemas/Group" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "$ref": "#/components/responses/NotFound" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/groups/create": {
      "post": {
        "tags": ["Groups"],
        "summary": "Create authenticated user's group",
        "operationId": "createGroup",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/GroupInput" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Created group.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["group"],
                  "properties": {
                    "group": { "$ref": "#/components/schemas/Group" }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "409": { "$ref": "#/components/responses/Conflict" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/ai/chat": {
      "post": {
        "tags": ["AI"],
        "summary": "Send a chat message",
        "operationId": "chat",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": { "$ref": "#/components/schemas/ChatInput" }
            }
          }
        },
        "responses": {
          "200": {
            "description": "AI-generated response text.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["message"],
                  "properties": { "message": { "type": "string" } }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/ai/extract-text": {
      "post": {
        "tags": ["AI"],
        "summary": "Extract visible text from an image",
        "operationId": "extractText",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/ImageUpload" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored text extraction result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["result"],
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/AiTextExtraction"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/ai/extract-receipt": {
      "post": {
        "tags": ["AI"],
        "summary": "Extract receipt line items from an image",
        "operationId": "extractReceipt",
        "security": [{ "cookieAuth": [] }],
        "requestBody": {
          "required": true,
          "content": {
            "multipart/form-data": {
              "schema": { "$ref": "#/components/schemas/ImageUpload" }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Stored receipt extraction result.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["result"],
                  "properties": {
                    "result": {
                      "$ref": "#/components/schemas/AiReceiptExtraction"
                    }
                  }
                }
              }
            }
          },
          "400": { "$ref": "#/components/responses/BadRequest" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    },
    "/ai/extractions": {
      "get": {
        "tags": ["AI"],
        "summary": "List latest extraction records",
        "operationId": "listExtractions",
        "security": [{ "cookieAuth": [] }],
        "responses": {
          "200": {
            "description": "Latest 20 extraction records for the authenticated user.",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "required": ["extractions"],
                  "properties": {
                    "extractions": {
                      "type": "array",
                      "items": { "$ref": "#/components/schemas/AiExtraction" }
                    }
                  }
                }
              }
            }
          },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "500": { "$ref": "#/components/responses/InternalServerError" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "cookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "access_token",
        "description": "HTTP-only access token cookie."
      },
      "refreshCookie": {
        "type": "apiKey",
        "in": "cookie",
        "name": "refresh_token",
        "description": "HTTP-only refresh token cookie scoped to /auth/refresh."
      }
    },
    "parameters": {
      "IdPathParam": {
        "name": "id",
        "in": "path",
        "required": true,
        "schema": { "$ref": "#/components/schemas/ObjectId" }
      }
    },
    "responses": {
      "AuthSuccess": {
        "description": "Authenticated user; sets access_token and refresh_token cookies.",
        "headers": {
          "Set-Cookie": {
            "description": "Includes access_token and refresh_token cookies.",
            "schema": { "type": "string" }
          }
        },
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/AuthResponse" }
          }
        }
      },
      "BadRequest": {
        "description": "Invalid request body, id, upload, or validation failure.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Unauthorized": {
        "description": "Missing, invalid, or expired authentication.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "NotFound": {
        "description": "Route or resource not found.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "Conflict": {
        "description": "Duplicate or conflicting resource.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      },
      "InternalServerError": {
        "description": "Unexpected server error.",
        "content": {
          "application/json": {
            "schema": { "$ref": "#/components/schemas/ErrorResponse" }
          }
        }
      }
    },
    "schemas": {
      "ObjectId": {
        "type": "string",
        "pattern": "^[0-9a-fA-F]{24}$",
        "example": "667000000000000000000000"
      },
      "IsoDateTime": {
        "type": "string",
        "format": "date-time",
        "example": "2026-06-22T12:00:00.000Z"
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["error"],
        "properties": { "error": { "type": "string" } },
        "additionalProperties": false
      },
      "OkResponse": {
        "type": "object",
        "required": ["ok"],
        "properties": { "ok": { "type": "boolean", "const": true } },
        "additionalProperties": false
      },
      "RootStatus": {
        "type": "object",
        "required": ["name", "status"],
        "properties": {
          "name": { "type": "string", "const": "BaseLayer" },
          "status": { "type": "string", "const": "ok" }
        },
        "additionalProperties": false
      },
      "HealthStatus": {
        "type": "object",
        "required": ["ok", "timestamp"],
        "properties": {
          "ok": { "type": "boolean", "const": true },
          "timestamp": { "$ref": "#/components/schemas/IsoDateTime" }
        },
        "additionalProperties": false
      },
      "AuthCredentials": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": { "type": "string", "example": "sophe" },
          "password": {
            "type": "string",
            "minLength": 8,
            "format": "password",
            "example": "password123"
          }
        },
        "additionalProperties": true
      },
      "AuthUser": {
        "type": "object",
        "required": ["id", "username"],
        "properties": {
          "id": { "$ref": "#/components/schemas/ObjectId" },
          "username": { "type": "string" }
        },
        "additionalProperties": false
      },
      "TokenUser": {
        "type": "object",
        "required": ["userId", "username"],
        "properties": {
          "userId": { "$ref": "#/components/schemas/ObjectId" },
          "username": { "type": "string" }
        },
        "additionalProperties": false
      },
      "AuthResponse": {
        "type": "object",
        "required": ["user"],
        "properties": { "user": { "$ref": "#/components/schemas/AuthUser" } },
        "additionalProperties": false
      },
      "MeResponse": {
        "type": "object",
        "required": ["user"],
        "properties": { "user": { "$ref": "#/components/schemas/TokenUser" } },
        "additionalProperties": false
      },
      "InsertOneResult": {
        "type": "object",
        "required": ["acknowledged", "insertedId"],
        "properties": {
          "acknowledged": { "type": "boolean" },
          "insertedId": { "$ref": "#/components/schemas/ObjectId" }
        },
        "additionalProperties": true
      },
      "ProjectInsertResponse": {
        "type": "object",
        "required": ["project"],
        "properties": {
          "project": { "$ref": "#/components/schemas/InsertOneResult" }
        },
        "additionalProperties": false
      },
      "ProjectProgressStartResponse": {
        "type": "object",
        "required": ["project", "status"],
        "properties": {
          "project": { "$ref": "#/components/schemas/InsertOneResult" },
          "status": { "type": "integer", "const": 201 }
        },
        "additionalProperties": false
      },
      "CurriculumItem": {
        "type": "object",
        "required": ["id", "title", "description"],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "description": { "type": "string" }
        },
        "additionalProperties": false
      },
      "ProjectLegend": {
        "type": "object",
        "required": ["difficulty", "type"],
        "properties": {
          "difficulty": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "example": { "1": "Beginner", "2": "Intermediate", "3": "Advanced" }
          },
          "type": {
            "type": "object",
            "additionalProperties": { "type": "string" },
            "example": { "phase": "Phase", "capstone": "Capstone" }
          }
        },
        "additionalProperties": false
      },
      "ProjectPhase": {
        "type": "object",
        "required": [
          "id",
          "title",
          "type",
          "difficulty",
          "summary",
          "concepts",
          "tools",
          "practice",
          "masteryChecks",
          "prerequisites"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "type": { "type": "string" },
          "difficulty": { "type": "number" },
          "summary": { "type": "string" },
          "concepts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CurriculumItem" }
          },
          "tools": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CurriculumItem" }
          },
          "practice": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CurriculumItem" }
          },
          "masteryChecks": { "type": "array", "items": { "type": "string" } },
          "prerequisites": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "ProjectCapstone": {
        "type": "object",
        "required": [
          "id",
          "title",
          "difficulty",
          "summary",
          "build",
          "concepts",
          "tools",
          "prerequisites"
        ],
        "properties": {
          "id": { "type": "string" },
          "title": { "type": "string" },
          "difficulty": { "type": "number" },
          "summary": { "type": "string" },
          "build": { "type": "array", "items": { "type": "string" } },
          "concepts": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CurriculumItem" }
          },
          "tools": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/CurriculumItem" }
          },
          "prerequisites": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": false
      },
      "ProjectInput": {
        "type": "object",
        "required": [
          "title",
          "description",
          "legend",
          "phases",
          "capstones",
          "recommendedOrder",
          "masteryDefinitions"
        ],
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "legend": { "$ref": "#/components/schemas/ProjectLegend" },
          "phases": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProjectPhase" }
          },
          "capstones": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProjectCapstone" }
          },
          "recommendedOrder": {
            "type": "array",
            "items": { "type": "string" }
          },
          "masteryDefinitions": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      },
      "ProjectUpdate": {
        "type": "object",
        "properties": {
          "title": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "legend": { "$ref": "#/components/schemas/ProjectLegend" },
          "phases": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProjectPhase" }
          },
          "capstones": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProjectCapstone" }
          },
          "recommendedOrder": {
            "type": "array",
            "items": { "type": "string" }
          },
          "masteryDefinitions": {
            "type": "array",
            "items": { "type": "string" }
          }
        },
        "additionalProperties": true
      },
      "Project": {
        "allOf": [
          { "$ref": "#/components/schemas/ProjectInput" },
          {
            "type": "object",
            "required": ["_id", "createdAt", "updatedAt"],
            "properties": {
              "_id": { "$ref": "#/components/schemas/ObjectId" },
              "createdAt": { "$ref": "#/components/schemas/IsoDateTime" },
              "updatedAt": { "$ref": "#/components/schemas/IsoDateTime" }
            }
          }
        ]
      },
      "CompletedItems": {
        "type": "object",
        "additionalProperties": { "type": "boolean" },
        "example": { "concept-variables": true, "tool-git": false }
      },
      "ProgressNote": {
        "type": "object",
        "required": ["text", "timestamp"],
        "properties": {
          "text": { "type": "string" },
          "timestamp": { "$ref": "#/components/schemas/IsoDateTime" }
        },
        "additionalProperties": false
      },
      "ProgressLink": {
        "type": "object",
        "required": ["text", "url"],
        "properties": {
          "text": { "type": "string" },
          "url": { "type": "string", "format": "uri" }
        },
        "additionalProperties": false
      },
      "ProgressNoteEntry": {
        "type": "object",
        "required": ["notes", "links"],
        "properties": {
          "notes": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProgressNote" }
          },
          "links": {
            "type": "array",
            "items": { "$ref": "#/components/schemas/ProgressLink" }
          }
        },
        "additionalProperties": false
      },
      "ProgressNotes": {
        "type": "object",
        "additionalProperties": {
          "$ref": "#/components/schemas/ProgressNoteEntry"
        }
      },
      "ProjectProgressInput": {
        "type": "object",
        "required": ["projectId"],
        "properties": {
          "projectId": { "$ref": "#/components/schemas/ObjectId" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "completedItems": { "$ref": "#/components/schemas/CompletedItems" },
          "progress": { "type": "number" },
          "notes": { "$ref": "#/components/schemas/ProgressNotes" }
        },
        "additionalProperties": true
      },
      "ProjectProgress": {
        "type": "object",
        "required": [
          "_id",
          "userId",
          "projectId",
          "title",
          "description",
          "completedItems",
          "progress",
          "notes",
          "createdAt",
          "updatedAt"
        ],
        "properties": {
          "_id": { "$ref": "#/components/schemas/ObjectId" },
          "userId": { "$ref": "#/components/schemas/ObjectId" },
          "projectId": { "$ref": "#/components/schemas/ObjectId" },
          "title": { "type": "string" },
          "description": { "type": "string" },
          "completedItems": { "$ref": "#/components/schemas/CompletedItems" },
          "progress": { "type": "number" },
          "notes": { "$ref": "#/components/schemas/ProgressNotes" },
          "createdAt": { "$ref": "#/components/schemas/IsoDateTime" },
          "updatedAt": { "$ref": "#/components/schemas/IsoDateTime" }
        },
        "additionalProperties": true
      },
      "ProjectProgressWithProject": {
        "allOf": [
          { "$ref": "#/components/schemas/ProjectProgress" },
          {
            "type": "object",
            "required": ["project"],
            "properties": {
              "project": { "$ref": "#/components/schemas/Project" }
            }
          }
        ]
      },
      "GroupInput": {
        "type": "object",
        "required": ["name", "people"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "people": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      },
      "GroupUpdate": {
        "type": "object",
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "people": { "type": "array", "items": { "type": "string" } }
        },
        "additionalProperties": true
      },
      "Group": {
        "allOf": [
          { "$ref": "#/components/schemas/GroupInput" },
          {
            "type": "object",
            "required": ["_id", "creatorId", "createdAt", "updatedAt"],
            "properties": {
              "_id": { "$ref": "#/components/schemas/ObjectId" },
              "creatorId": { "$ref": "#/components/schemas/ObjectId" },
              "createdAt": { "$ref": "#/components/schemas/IsoDateTime" },
              "updatedAt": { "$ref": "#/components/schemas/IsoDateTime" }
            }
          }
        ]
      },
      "ChatInput": {
        "type": "object",
        "required": ["message"],
        "properties": { "message": { "type": "string", "minLength": 1 } },
        "additionalProperties": true
      },
      "ImageUpload": {
        "type": "object",
        "required": ["image"],
        "properties": {
          "image": {
            "type": "string",
            "format": "binary",
            "description": "PNG, JPEG, or WebP image under 10 MB."
          }
        },
        "additionalProperties": true
      },
      "ReceiptItem": {
        "type": "object",
        "required": ["name", "amount"],
        "properties": {
          "name": { "type": "string" },
          "amount": { "type": "number" }
        },
        "additionalProperties": false
      },
      "AiExtractionBase": {
        "type": "object",
        "required": ["_id", "userId", "mimeType", "createdAt"],
        "properties": {
          "_id": { "$ref": "#/components/schemas/ObjectId" },
          "userId": { "$ref": "#/components/schemas/ObjectId" },
          "fileName": { "type": "string" },
          "mimeType": {
            "type": "string",
            "enum": ["image/png", "image/jpeg", "image/webp"]
          },
          "createdAt": { "$ref": "#/components/schemas/IsoDateTime" }
        },
        "additionalProperties": true
      },
      "AiTextExtraction": {
        "allOf": [
          { "$ref": "#/components/schemas/AiExtractionBase" },
          {
            "type": "object",
            "required": ["extractedText"],
            "properties": { "extractedText": { "type": "string" } }
          }
        ]
      },
      "AiReceiptExtraction": {
        "allOf": [
          { "$ref": "#/components/schemas/AiExtractionBase" },
          {
            "type": "object",
            "required": ["extractedObject"],
            "properties": {
              "extractedObject": {
                "type": "array",
                "items": { "$ref": "#/components/schemas/ReceiptItem" }
              }
            }
          }
        ]
      },
      "AiExtraction": {
        "oneOf": [
          { "$ref": "#/components/schemas/AiTextExtraction" },
          { "$ref": "#/components/schemas/AiReceiptExtraction" }
        ]
      }
    }
  }
}
